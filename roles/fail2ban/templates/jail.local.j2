# Managed by Ansible — roles/fail2ban
[DEFAULT]
# This host has no iptables binary. A jail left on iptables-multiport looks
# perfectly healthy and bans nothing at all.
banaction          = {{ f2b_banaction }}
banaction_allports = {{ f2b_banaction_allports }}

# ssh_admin_sources are the only management paths in (Mgmt VLAN and the admin
# desktop). A self-ban there means recovery at the console.
ignoreip = {{ f2b_ignoreip }}

[sshd]
enabled  = true
port     = {{ ssh_port }}
backend  = systemd

# No caddy-404 jail (DR-005). It could detect but never block: behind
# Cloudflare the source of every packet is a Cloudflare address. Scanner paths
# are blocked at Cloudflare's edge instead (cloudflare/waf-block-scanners.txt).
