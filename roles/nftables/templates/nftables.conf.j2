#!/usr/sbin/nft -f
# Managed by Ansible — roles/nftables

# Replace only this table, never `flush ruleset`. fail2ban maintains its own
# `inet f2b-table` at a higher priority; flushing everything would delete its
# active bans out from under it, and fail2ban would keep reporting them as
# banned while the kernel no longer enforced anything.
#
# The bare declaration creates the table if it does not exist, so the delete
# that follows cannot fail on a fresh host.
table inet filter
delete table inet filter

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop
        iif lo accept

        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } accept
        # ICMPv6 enumerated rather than blanket-accepted: NDP needs specific
        # types and nothing else has to get through.
        ip6 nexthdr icmpv6 icmpv6 type { echo-request, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, packet-too-big, destination-unreachable, time-exceeded } accept

        tcp dport { {{ nft_public_tcp_ports | join(', ') }} } accept

        # HTTP/3 (udp 443) deliberately absent: not forwarded at the router,
        # and Cloudflare reaches origin over TCP. Caddy is configured not to
        # advertise h3 so clients don't attempt QUIC and fall back.

        # Source-scoped, not interface-scoped: there is no management interface
        # on this host any more. OPNsense enforces the same scope upstream.
        ip saddr { {{ ssh_admin_sources | join(', ') }} } tcp dport {{ ssh_port }} accept comment "ssh — mgmt + admin desktop only"

        counter comment "dropped"
    }
    # This host does not route. Nothing is forwarded, ever.
    chain forward { type filter hook forward priority 0; policy drop; }
    chain output  { type filter hook output  priority 0; policy accept; }
}
