# Managed by Ansible — roles/caddy
{
    servers {
        # h3 omitted: udp/443 is not forwarded and Cloudflare reaches origin
        # over TCP. Advertising alt-svc h3 only makes clients try QUIC, fail,
        # and fall back.
        protocols {{ caddy_protocols }}

        # Security-critical, not cosmetic. Without this every access-log entry
        # records a Cloudflare edge IP instead of the visitor, and the
        # caddy-404 fail2ban jail bans Cloudflare. Correctly scoped, forged
        # CF-Connecting-IP headers from untrusted sources are ignored.
        trusted_proxies static {{ caddy_trusted_proxies | join(' ') }}
    }
}

{{ caddy_site_domains | join(', ') }} {
    root * {{ caddy_web_root }}
    file_server
    encode gzip

    header {
{% for name, value in caddy_security_headers.items() %}
        {{ name }} "{{ value }}"
{% endfor %}
        -Server
    }

    # Access logging is off by default; the caddy-404 jail depends on it.
    log {
        output file {{ caddy_log_path }}
        format json
    }
}
