# Managed by Ansible — roles/caddy
[Service]
# No LogsDirectory= (DR-005). systemd re-owns that directory to User:Group
# on every start, recursively, which stripped the caddylog group and the
# setgid bit and locked the traffic report out after each restart.
# roles/caddy creates the directory; this only makes it writable.
ReadWritePaths={{ caddy_log_path | dirname }}

# Soft GC target. Caddy otherwise infers ~890MB from total RAM, which is most
# of a 1GB board.
Environment="GOMEMLIMIT={{ caddy_gomemlimit }}"

# Hard cgroup ceiling: kill Caddy rather than let it drag the host into swap.
MemoryMax={{ caddy_memory_max }}
