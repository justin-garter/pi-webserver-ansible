# Managed by Ansible — roles/base
# The DMZ has no DHCP (DR-003, amended 2026-09-29). This file is the only
# source of the host's address; cloud-init's copy is removed.
network:
  version: 2
  renderer: NetworkManager
  ethernets:
    {{ dmz_interface }}:
      dhcp4: false
      dhcp6: false
      accept-ra: false
      addresses: [{{ dmz_address }}/{{ dmz_prefix }}]
      routes:
        - to: default
          via: {{ dmz_gateway }}
      nameservers:
        addresses: [{{ dmz_dns | join(', ') }}]
